#!/bin/zsh
set -euo pipefail

root="${0:A:h:h}"
cd "$root"

swift test
Scripts/build-app
codesign --verify --deep --strict dist/Context.app

if [[ "${CONTEXT_VERIFY_LAUNCH:-0}" == "1" ]]; then
  nohup "$root/dist/Context.app/Contents/MacOS/ContextApp" >/dev/null 2>&1 &
  sleep 3
  pgrep -f "$root/dist/Context.app/Contents/MacOS/ContextApp" >/dev/null \
    || { print -u2 "Context did not remain running after launch"; exit 1; }
fi

print "Context verification passed."
